# Laires API Keys Configuration
# Copy this file to '.env' and add the keys for the providers you plan to use.
# You only need the key for the provider selected in your `.laires/config.toml`

# Google Gemini (Default)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here

# Note: Local LLMs (e.g., Ollama) typically do not require an API key.
